  "sections": [
    {
      "key": "A",
      "label": { "fr": "A. En-tête enquêteur (avant de commencer)" },
      "description": { "fr": "Une personne = une fiche. Toujours le même code sur la fiche, le reçu MoMo et le tableau de suivi." },
      "items": [
        {
          "key": "regles_enqueteur",
          "type": "note",
          "audience": "enumerator",
          "style": "warning",
          "label": { "fr": "À relire chaque matin. Présenter le concept tel quel, montrer l'appareil, puis se taire. Noter les réponses ouvertes mot pour mot : pas de résumé. Ne jamais convaincre, corriger une objection ni inventer une promo. Ne pas recruter plus de 5 personnes du même réseau. Vérifier le filtre avant de s'asseoir." }
        },
        { "key": "date_entretien", "type": "date", "label": { "fr": "Date de l'entretien" }, "required": true, "default": { "today": [] } },
        { "key": "ville", "type": "select_one", "label": { "fr": "Ville" }, "required": true, "choices": "villes", "appearance": "buttons" },
        { "key": "quartier", "type": "select_one", "label": { "fr": "Quartier" }, "required": true, "choices": "quartiers", "appearance": "dropdown", "hint": { "fr": "Mix volontaire : ne pas tout prendre dans Makepe / Logpom." } },
        { "key": "lieu_precis", "type": "text", "label": { "fr": "Lieu (repère précis du point d'enquête)" }, "max_length": 120 },
        {
          "key": "lieu_enrolement",
          "type": "select_one",
          "label": { "fr": "Lieu d'enrôlement du répondant" },
          "required": true,
          "choices": "lieux_enrolement",
          "other": { "choice": "autre", "label": { "fr": "Précisez le lieu d'enrôlement" } }
        },
        {
          "key": "reseau_origine",
          "type": "text",
          "label": { "fr": "Réseau d'origine (nom du relais, sinon « direct »)" },
          "required": true,
          "default": "direct",
          "max_length": 60,
          "hint": { "fr": "Maximum 5 personnes du même réseau / même église / même école / même famille élargie." }
        },
        { "key": "numero_fiche", "type": "calculate", "label": { "fr": "Numéro de fiche (compteur du code fiche)" }, "expression": { "var": "_seq" } }
      ]
    },
    {
      "key": "B",
      "label": { "fr": "B. Introduction — 90 secondes. Si KO, on arrête." },
      "items": [
        {
          "key": "script_intro",
          "type": "note",
          "audience": "respondent",
          "style": "script",
          "label": { "fr": "« Bonjour Madame, Monsieur, je me présente : [Prénom Nom], représentant Honowa Tech. Nous menons actuellement une enquête sur la sécurité des enfants en milieu urbain dans le cadre du projet MunaGo. MunaGo est un service d'abonnement proposant un traceur GPS destiné aux familles vivant en ville. Cette entrevue durera environ quinze minutes. Acceptez-vous d'y participer ? »" }
        },
        { "key": "consentement", "type": "select_one", "label": { "fr": "Acceptez-vous de participer ?" }, "required": true, "choices": "oui_non" },
        {
          "key": "stop_refus",
          "type": "stop",
          "label": { "fr": "Fin de l'entretien" },
          "message": { "fr": "La personne refuse de participer. Remercier et partir, sans insister." },
          "relevant": { "==": [{ "var": "consentement" }, "non"] }
        },
        { "key": "deja_contacte", "type": "select_one", "label": { "fr": "B2. Avez-vous déjà été contacté au sujet du projet MunaGo ?" }, "required": true, "choices": "oui_non" },
        {
          "key": "stop_deja_contacte",
          "type": "stop",
          "label": { "fr": "Fin de l'entretien — déjà contacté" },
          "message": { "fr": "Famille déjà vue au pilote ou déjà contactée sur WhatsApp pour MunaGo. Remercier et partir." },
          "relevant": { "==": [{ "var": "deja_contacte" }, "oui"] }
        },
        { "key": "f1_enfant_scolarise", "type": "select_one", "label": { "fr": "F1. Avez-vous au moins un enfant de 3 à 18 ans scolarisé ?" }, "required": true, "choices": "oui_non" },
        {
          "key": "stop_pas_enfant",
          "type": "stop",
          "label": { "fr": "Hors cible — pas d'enfant scolarisé" },
          "message": { "fr": "Aucun enfant de 3 à 18 ans scolarisé : noter le motif, remercier et partir." },
          "relevant": { "==": [{ "var": "f1_enfant_scolarise" }, "non"] }
        },
        {
          "key": "f2_capacite",
          "type": "select_multiple",
          "label": { "fr": "F2. Parmi ces situations, laquelle est vraie chez vous ? (Au moins une obligatoire)" },
          "required": true,
          "choices": "signaux_capacite",
          "exclusive": ["aucune"],
          "min_selected": 1
        },
        {
          "key": "stop_hors_cible",
          "type": "stop",
          "label": { "fr": "Hors cible — aucun signal de capacité" },
          "message": { "fr": "Aucun des signaux de capacité : noter le motif et remercier." },
          "relevant": { "selected": [{ "var": "f2_capacite" }, "aucune"] }
        },
        { "key": "nb_signaux", "type": "calculate", "label": { "fr": "Nombre de signaux de capacité" }, "expression": { "count_selected": [{ "var": "f2_capacite" }] } },
        {
          "key": "resultat_filtre",
          "type": "calculate",
          "label": { "fr": "Filtre : VALIDE / HORS CIBLE" },
          "expression": {
            "if": [
              { "or": [
                { "==": [{ "var": "consentement" }, "non"] },
                { "==": [{ "var": "deja_contacte" }, "oui"] },
                { "==": [{ "var": "f1_enfant_scolarise" }, "non"] },
                { "selected": [{ "var": "f2_capacite" }, "aucune"] }
              ] },
              "hors_cible",
              "valide"
            ]
          }
        },
        { "key": "sexe", "type": "select_one", "label": { "fr": "Sexe du répondant" }, "required": true, "choices": "sexes", "appearance": "buttons", "tags": ["enumerator_only"] },
        { "key": "age_approx", "type": "integer", "label": { "fr": "Âge approximatif (ans)" }, "required": true, "min": 15, "max": 90, "tags": ["enumerator_only"] }
      ]
    },
    {
      "key": "C",
      "label": { "fr": "C. Profil du ménage (fermé — 2 minutes)" },
      "items": [
        { "key": "nb_enfants_scolarises", "type": "integer", "label": { "fr": "P1. Nombre d'enfants scolarisés de 3 à 18 ans" }, "required": true, "min": 1, "max": 15 },
        {
          "key": "p1_composition",
          "type": "group",
          "label": { "fr": "P1. Composition utile" },
          "appearance": "matrix",
          "items": [
            { "key": "p1_ecole_privee", "type": "select_one", "label": { "fr": "École privée" }, "required": true, "choices": "oui_non" },
