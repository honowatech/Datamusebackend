  "version": 1,
  "title": {
    "fr": "MunaGo — questionnaire d'étude de marché terrain"
  },
  "description": {
    "fr": "Familles urbaines · Douala · entretien face à face 12–15 min + test d'acompte. Décider si le projet MunaGo mérite d'être poursuivi : seuls comptent les gestes qui coûtent quelque chose."
  },
  "settings": {
    "languages": ["fr"],
    "default_language": "fr",
    "fiche_code": {
      "pattern": "{VILLE}-{QUARTIER}-{NN}",
      "sources": { "VILLE": "ville", "QUARTIER": "quartier" },
      "counter": { "width": 2, "scope": "sources", "start": 1 }
    },
    "quotas": [
      { "key": "fiches_valides", "label": { "fr": "Échantillon minimum : 30 fiches valides" }, "target": 30, "scope": "survey" },
      { "key": "quartiers_distincts", "label": { "fr": "Au moins 3 quartiers distincts par ville travaillée" }, "target": 3, "scope": "distinct", "question": "quartier" },
      { "key": "par_reseau", "label": { "fr": "Maximum 5 personnes du même réseau" }, "target": 5, "scope": "answer", "question": "reseau_origine", "max": true }
    ],
    "kpis": [
      {
        "key": "taux_acompte",
        "label": { "fr": "% d'acompte / fiches valides" },
        "numerator": { "==": [{ "var": "acompte_verse" }, true] },
        "denominator": "valid",
        "format": "percent"
      },
      {
        "key": "taux_retrait",
        "label": { "fr": "% de retrait ≤ 7 j parmi les acomptes" },
        "numerator": { "==": [{ "var": "j7_retire" }, "oui"] },
        "denominator": { "==": [{ "var": "acompte_verse" }, true] },
        "format": "percent"
      },
      {
        "key": "taux_activation_j14",
        "label": { "fr": "% activé à J+14 parmi les appareils retirés" },
        "numerator": { "==": [{ "var": "j14_active" }, "oui"] },
        "denominator": { "==": [{ "var": "j7_retire" }, "oui"] },
        "format": "percent"
      },
      {
        "key": "taux_hors_cible",
        "label": { "fr": "% hors cible / contacts" },
        "numerator": { "==": [{ "var": "_status" }, "screened_out"] },
        "denominator": "all",
        "format": "percent"
      }
    ],
    "geo": { "capture": "end", "required": false, "accuracy_max_m": 100 },
    "timing": { "min_duration_seconds": 600, "max_duration_seconds": 1080 },
    "duplicate_keys": ["num_whatsapp"],
    "pagination": "section",
    "allow_public_link": true,
    "enumerator_can_edit_after_submit": true,
    "followup_contact_keys": ["num_whatsapp"]
  },
