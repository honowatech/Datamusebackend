{
  "prompt": "verbatim_classify",
  "description": "Classification d'un lot de verbatims sur un livre de codes. La transformation `verbatim_classify` lit le lot [{ref, text}] réellement envoyé et renvoie un codage pour CHAQUE `ref` demandé : un verbatim absent de la table reçoit le `fallback` (aucun thème, confiance 0.2), ce qui reproduit le comportement d'un modèle honnête sur un texte hors corpus. Codages rédigés à la main — résultat SIMULÉ.",
  "rules": [
    { "id": "q6_freins", "when": { "vars": { "question_key": "q6_freins" } }, "response": "q6_freins.json", "transform": "verbatim_classify" },
    { "id": "q14_motif", "when": { "vars": { "question_key": "q14_motif" } }, "response": "q14_motif.json", "transform": "verbatim_classify" },
    { "id": "q5_reaction", "when": { "vars": { "question_key": "q5_reaction" } }, "response": "q5_reaction.json", "transform": "verbatim_classify" },
    { "id": "q12_conditions", "when": { "vars": { "question_key": "q12_conditions" } }, "response": "q12_conditions.json", "transform": "verbatim_classify" },
    { "id": "q7_circonstances", "when": { "vars": { "question_key": "q7_circonstances" } }, "response": "q7_circonstances.json", "transform": "verbatim_classify" },
    { "id": "d1_precision", "when": { "vars": { "question_key": "d1_precision" } }, "response": "d1_precision.json", "transform": "verbatim_classify" },
    { "id": "d3_recit", "when": { "vars": { "question_key": "d3_recit" } }, "response": "d3_recit.json", "transform": "verbatim_classify" },
    { "id": "d4_verbatim", "when": { "vars": { "question_key": "d4_verbatim" } }, "response": "d4_verbatim.json", "transform": "verbatim_classify" }
  ]
}
