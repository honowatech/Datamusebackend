    "non_clair_n": ["NON clair : (\\d+)", "null"],
    "hesite_non_n": ["Hésite longtemps puis non : (\\d+)", "null"],
    "hesite_oui_n": ["Hésite longtemps puis oui \\+ paiement : (\\d+)", "null"],
    "refus_argent_n": ["Pas l'argent maintenant : (\\d+)", "null"],
    "refus_conjoint_n": ["Doit en parler au conjoint : (\\d+)", "null"],
    "refus_produit_n": ["Pas convaincu du produit : (\\d+)", "null"],
