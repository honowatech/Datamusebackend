    "frein_1_n": ["q6_freins., \\d+ codés\\)\\n- \\*\\*[^*]+\\*\\* : (\\d+)", "null"],
    "frein_1_pct": ["q6_freins., \\d+ codés\\)\\n- \\*\\*[^*]+\\*\\* : \\d+ \\(([\\d.,]+) %\\)", "null"],
    "frein_1_quote": ["q6_freins., \\d+ codés\\)\\n- \\*\\*[^*]+\\*\\* : [^\\n]*\\n  > ([^\\n]+)", "(aucun verbatim codé pour cette question)"],
    "frein_2_label": ["q6_freins., \\d+ codés\\)\\n(?:- \\*\\*[^*]+\\*\\* :[^\\n]*\\n(?:  > [^\\n]*\\n)*){1}- \\*\\*([^*]+)\\*\\*", "non classé"],
    "frein_2_n": ["q6_freins., \\d+ codés\\)\\n(?:- \\*\\*[^*]+\\*\\* :[^\\n]*\\n(?:  > [^\\n]*\\n)*){1}- \\*\\*[^*]+\\*\\* : (\\d+)", "null"],
    "frein_2_pct": ["q6_freins., \\d+ codés\\)\\n(?:- \\*\\*[^*]+\\*\\* :[^\\n]*\\n(?:  > [^\\n]*\\n)*){1}- \\*\\*[^*]+\\*\\* : \\d+ \\(([\\d.,]+) %\\)", "null"],
    "frein_3_label": ["q6_freins., \\d+ codés\\)\\n(?:- \\*\\*[^*]+\\*\\* :[^\\n]*\\n(?:  > [^\\n]*\\n)*){2}- \\*\\*([^*]+)\\*\\*", "non classé"],
    "frein_3_n": ["q6_freins., \\d+ codés\\)\\n(?:- \\*\\*[^*]+\\*\\* :[^\\n]*\\n(?:  > [^\\n]*\\n)*){2}- \\*\\*[^*]+\\*\\* : (\\d+)", "null"],
    "frein_3_pct": ["q6_freins., \\d+ codés\\)\\n(?:- \\*\\*[^*]+\\*\\* :[^\\n]*\\n(?:  > [^\\n]*\\n)*){2}- \\*\\*[^*]+\\*\\* : \\d+ \\(([\\d.,]+) %\\)", "null"],
    "q14_codes": ["q14_motif., (\\d+) codés", "0"],
    "refus_1_label": ["q14_motif., \\d+ codés\\)\\n- \\*\\*([^*]+)\\*\\*", "non classé"],
    "refus_1_quote": ["q14_motif., \\d+ codés\\)\\n- \\*\\*[^*]+\\*\\* : [^\\n]*\\n  > ([^\\n]+)", "(aucun verbatim codé pour cette question)"]
  },
  "rules": [
    {
      "id": "munago-variante-invalide",
      "comment": "Écrire « demo-reparation » dans le brief force une réponse volontairement invalide (propriété inventée à la racine et dans une section, `trend` hors énumération, `level` = 4, ligne de tableau trop courte) : elle déclenche la tentative report_repair, qui rend la version corrigée.",
      "when": { "contains": ["demo-reparation"] },
      "response": "munago.invalide.json"
    },
    {
      "id": "munago-executif",
      "when": { "vars": { "orientation": ["executif", "synthese"] } },
      "response": "munago.executif.json"
    }
  ],
  "default": {
    "comment": "Orientation `commercial` (et repli général) : le plan long, avec méthodologie, chaîne d'engagement, freins, prix, mécanique de paiement et recommandation go/no-go.",
    "response": "munago.commercial.json"
  }
}
