    "n_total": ["Fiches exploitables : (\\d+)", "null"],
    "n_valides": ["dont (\\d+) valides", "null"],
    "n_hors_cible": ["valides, (\\d+) hors cible", "null"],
    "duree_mediane": ["Durée médiane : (\\d+) s", "null"],
    "taux_acompte": ["acompte / fiches valides : ([\\d.,]+) %", "null"],
