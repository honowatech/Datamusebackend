    "acompte_d": ["acompte / fiches valides : [^(]*\\(\\d+/(\\d+)\\)", "null"],
    "taux_retrait": ["parmi les acomptes : ([\\d.,]+) %", "null"],
    "retrait_n": ["parmi les acomptes : [^(]*\\((\\d+)", "null"],
    "retrait_d": ["parmi les acomptes : [^(]*\\(\\d+/(\\d+)\\)", "null"],
    "taux_activation": ["parmi les appareils retirés : ([\\d.,]+) %", "null"],
    "activation_n": ["parmi les appareils retirés : [^(]*\\((\\d+)", "null"],
    "activation_d": ["parmi les appareils retirés : [^(]*\\(\\d+/(\\d+)\\)", "null"],
    "taux_hors_cible": ["hors cible / contacts : ([\\d.,]+) %", "null"],
    "quota_reseau": ["Maximum 5 [^:]*: (\\d+)", "null"],
    "prix_rupture_mediane": ["f2_prix_rupture[^#]*médiane ([\\d.]+)", "null"],
    "prix_rupture_n": ["f2_prix_rupture., n = (\\d+)", "null"],
    "prix_normal_n": ["C'est normal : (\\d+)", "null"],
    "prix_normal_pct": ["C'est normal : \\d+ \\(([\\d.,]+) %\\)", "null"],
    "prix_acceptable_n": ["C'est cher mais acceptable : (\\d+)", "null"],
    "prix_appareil_acceptable_pct": ["C'est cher mais acceptable : \\d+ \\(([\\d.,]+) %\\)", "null"],
    "prix_trop_cher_n": ["C'est trop cher : (\\d+)", "null"],
