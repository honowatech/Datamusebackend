    "refus_deplacement_n": ["Ne veut pas se déplacer : (\\d+)", "null"],
    "refus_loin_n": ["Lieu de retrait trop loin : (\\d+)", "null"],
    "femmes_n": ["Femme : (\\d+)", "null"],
    "femmes_pct": ["Femme : \\d+ \\(([\\d.,]+) %\\)", "null"],
    "age_median": ["age_approx., n = \\d+\\)\\n- moyenne [\\d.]+ · médiane ([\\d.]+)", "null"],
    "enfants_mediane": ["nb_enfants_scolarises., n = \\d+\\)\\n- moyenne [\\d.]+ · médiane ([\\d.]+)", "null"],
