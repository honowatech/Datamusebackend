# ─────────────────────────────────────────────────────────────
# Datamuse Backend - Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
# NEVER commit the .env file to version control.

APP_NAME=Datamuse
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# ─── Database (Backend / Sanctum) ────────────────────────────
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=datamuse
# DB_USERNAME=root
# DB_PASSWORD=

# ─── Sessions ────────────────────────────────────────────────
SESSION_DRIVER=database

# ─── AI API Keys (Global / Server-side) ──────────────────────
# If set, these keys are used for ALL users by default.
# Users can also configure their own keys (encrypted in DB).
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Modèles par défaut (surchargeables par requête via options.model)
GEMINI_MODEL=gemini-1.5-flash
DEEPSEEK_MODEL=deepseek-chat

# ─── CORS ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Origines supplémentaires autorisées (liste CSV, ex. https://admin.example.com,capacitor://localhost)
CORS_EXTRA_ORIGINS=

# ─── Module Enquêtes ─────────────────────────────────────────
# Disque de stockage des médias (photos, signatures, audio) : privé, servi via URL signée /api/media/{id}
SURVEY_MEDIA_DISK=local
# Taille maximale d'un média envoyé par le mobile (Mo) ; au-delà : 413.
# Pensez à aligner upload_max_filesize / post_max_size (PHP) et client_max_body_size (Nginx).
SURVEY_MEDIA_MAX_MB=25
# Répertoire des SQLite matérialisés (défaut : storage/app/imported_databases)
SURVEY_DATASOURCE_DIR=
# Délai avant reconstruction après une soumission (s) : regroupe les rafales de synchronisation.
SURVEY_MATERIALIZE_DELAY=30
# Anciennes versions de fichier conservées par `datasources:cleanup-old-files`.
SURVEY_DATASOURCE_KEEP_VERSIONS=0
# File d'attente des jobs IA / matérialisation : database + `php artisan queue:work`
# Tâches planifiées (suivis échus, matérialisation, purge) : `php artisan schedule:work`.
QUEUE_CONNECTION=database

# ─── Logging ─────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
