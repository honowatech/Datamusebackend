# ─────────────────────────────────────────────────────────────
# Datamuse Backend - Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
# NEVER commit the .env file to version control.

APP_NAME=Datamuse
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# ─── Database (Backend / Sanctum) ────────────────────────────
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=datamuse
# DB_USERNAME=root
# DB_PASSWORD=

# ─── Sessions ────────────────────────────────────────────────
SESSION_DRIVER=database

# ─── AI API Keys (Global / Server-side) ──────────────────────
# If set, these keys are used for ALL users by default.
# Users can also configure their own keys (encrypted in DB).
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ─── CORS ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Logging ─────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
