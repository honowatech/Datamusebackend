  "sections": [
    {
      "key": "A",
      "label": { "fr": "A. En-tête enquêteur", "en": "A. Enumerator header" },
      "description": { "fr": "Avant de commencer. Code fiche VILLE-QUARTIER-NN (ex. DLA-BMP-07) : toujours le même code sur la fiche, le reçu MoMo et le tableau de suivi.", "en": "Before starting. Form code CITY-NEIGHBOURHOOD-NN (e.g. DLA-BMP-07): always the same code on the form, the MoMo receipt and the follow-up table." },
      "items": [
        { "key": "a_consigne_regles", "type": "note", "audience": "enumerator", "style": "warning",
          "label": { "fr": "Règles du jour : vérifier le filtre avant de s'asseoir. Une fiche = une personne. Ne pas recruter plus de 5 personnes du même réseau / église / école / famille élargie. Ne pas interroger une famille déjà vue au pilote ou déjà contactée sur WhatsApp pour MunaGo. On coche et on écrit pendant l'entretien, jamais de mémoire après coup.", "en": "Rules of the day: check the screening before sitting down. One form = one person. Do not recruit more than 5 people from the same network / church / school / extended family. Do not interview a family already seen in the pilot or already contacted on WhatsApp about MunaGo. Tick and write during the interview, never from memory afterwards." } },
        { "key": "date_entretien", "type": "calculate", "label": { "fr": "Date de l'entretien", "en": "Interview date" }, "expression": { "today": [] } },
        { "key": "heure_debut", "type": "calculate", "label": { "fr": "Heure de début", "en": "Start time" }, "expression": { "var": "_start_time" } },
        { "key": "heure_fin", "type": "calculate", "label": { "fr": "Heure de fin", "en": "End time" }, "expression": { "var": "_end_time" } },
        { "key": "enqueteur", "type": "calculate", "label": { "fr": "Enquêteur", "en": "Enumerator" }, "expression": { "var": "_enumerator" } },
        { "key": "ville", "type": "select_one", "label": { "fr": "Ville", "en": "City" }, "required": true, "choices": "villes", "appearance": "buttons" },
        { "key": "quartier", "type": "select_one", "label": { "fr": "Quartier", "en": "Neighbourhood" }, "required": true, "choices": "quartiers", "appearance": "dropdown",
          "hint": { "fr": "Mix volontaire : ne pas tout prendre dans Makepe / Logpom.", "en": "Deliberate mix: do not take everything from Makepe / Logpom." } },
        { "key": "lieu", "type": "text", "label": { "fr": "Lieu", "en": "Place" }, "hint": { "fr": "Précision du lieu de l'entretien (rue, école, marché…).", "en": "Interview place detail (street, school, market…)." }, "max_length": 120 },
        { "key": "lieu_enrolement", "type": "select_one", "label": { "fr": "Lieu d'enrôlement du répondant", "en": "Where the respondent was recruited" }, "required": true, "choices": "lieux_enrolement",
          "other": { "choice": "autre", "label": { "fr": "Précisez le lieu", "en": "Specify the place" } } },
        { "key": "reseau_origine", "type": "text", "label": { "fr": "Réseau d'origine (nom du relais, sinon « direct »)", "en": "Origin network (name of the relay, otherwise \"direct\")" }, "required": true, "default": "direct", "max_length": 60,
          "hint": { "fr": "Maximum 5 fiches par réseau : église, école, famille élargie…", "en": "At most 5 forms per network: church, school, extended family…" } },
        { "key": "numero_fiche", "type": "calculate", "label": { "fr": "Numéro de fiche (compteur du code fiche)", "en": "Form number (form code counter)" }, "expression": { "var": "_seq" } }
      ]
    },
    {
      "key": "B",
      "label": { "fr": "B. Introduction et éligibilité", "en": "B. Introduction and eligibility" },
      "description": { "fr": "90 secondes. Si KO, on arrête.", "en": "90 seconds. If KO, we stop." },
      "items": [
        { "key": "b_intro_script", "type": "note", "audience": "respondent", "style": "script",
          "label": { "fr": "« Bonjour Madame, Monsieur. Je me présente : [Prénom Nom], représentant Honowa Tech. Nous menons actuellement une enquête sur la sécurité des enfants en milieu urbain dans le cadre du projet MunaGo. MunaGo est un service d'abonnement proposant un traceur GPS destiné aux familles vivant en ville. Cette entrevue durera environ quinze minutes. Acceptez-vous d'y participer ? »", "en": "\"Good morning Madam, Sir. My name is [First name Last name], representing Honowa Tech. We are currently conducting a survey on child safety in urban areas as part of the MunaGo project. MunaGo is a subscription service offering a GPS tracker for families living in the city. This interview will last about fifteen minutes. Do you agree to take part?\"" } },
        { "key": "consentement", "type": "select_one", "label": { "fr": "Acceptez-vous de participer ?", "en": "Do you agree to take part?" }, "required": true, "choices": "oui_non", "appearance": "buttons" },
        { "key": "stop_consentement", "type": "stop", "label": { "fr": "Fin de l'entretien", "en": "End of interview" },
          "message": { "fr": "La personne refuse de participer. Remercier et partir.", "en": "The person declines to take part. Thank them and leave." },
          "relevant": { "==": [{ "var": "consentement" }, "non"] } },
        { "key": "deja_contacte", "type": "select_one", "label": { "fr": "B2. Avez-vous déjà été contacté au sujet du projet MunaGo ?", "en": "B2. Have you already been contacted about the MunaGo project?" }, "required": true, "choices": "oui_non", "appearance": "buttons" },
        { "key": "stop_deja_contacte", "type": "stop", "label": { "fr": "Fin de l'entretien — déjà contacté", "en": "End of interview — already contacted" },
          "message": { "fr": "Famille déjà vue au pilote ou déjà contactée sur WhatsApp : ne pas interroger. Remercier et partir.", "en": "Family already seen in the pilot or already contacted on WhatsApp: do not interview. Thank them and leave." },
          "relevant": { "==": [{ "var": "deja_contacte" }, "oui"] } },
        { "key": "f1_enfant_scolarise", "type": "select_one", "label": { "fr": "F1. Avez-vous au moins un enfant de 3 à 18 ans scolarisé ?", "en": "F1. Do you have at least one child aged 3 to 18 attending school?" }, "required": true, "choices": "oui_non", "appearance": "buttons" },
        { "key": "stop_f1_enfant", "type": "stop", "label": { "fr": "Hors cible — pas d'enfant scolarisé", "en": "Screened out — no school-age child" },
          "message": { "fr": "Aucun enfant de 3 à 18 ans scolarisé. Remercier et partir.", "en": "No child aged 3 to 18 attending school. Thank them and leave." },
          "relevant": { "==": [{ "var": "f1_enfant_scolarise" }, "non"] } },
        { "key": "f2_capacite", "type": "select_multiple", "label": { "fr": "F2. Parmi ces situations, laquelle est vraie chez vous ? (Au moins une obligatoire)", "en": "F2. Which of these situations is true in your household? (At least one required)" }, "required": true, "choices": "signaux_capacite",
          "min_selected": 1, "exclusive": ["aucune"], "appearance": "checkbox" },
        { "key": "stop_f2_capacite", "type": "stop", "label": { "fr": "Hors cible — aucun signal de capacité", "en": "Screened out — no capacity signal" },
          "message": { "fr": "Aucune des quatre situations : noter le motif, remercier et partir.", "en": "None of the four situations: note the reason, thank them and leave." },
          "relevant": { "selected": [{ "var": "f2_capacite" }, "aucune"] } },
        { "key": "nb_signaux", "type": "calculate", "label": { "fr": "Nombre de signaux de capacité", "en": "Number of capacity signals" }, "expression": { "count_selected": [{ "var": "f2_capacite" }] } },
        { "key": "resultat_filtre", "type": "calculate", "label": { "fr": "Filtre : VALIDE / HORS CIBLE", "en": "Screening: VALID / OUT OF TARGET" },
          "expression": { "if": [
            { "or": [
              { "==": [{ "var": "consentement" }, "non"] },
              { "==": [{ "var": "deja_contacte" }, "oui"] },
              { "==": [{ "var": "f1_enfant_scolarise" }, "non"] },
              { "selected": [{ "var": "f2_capacite" }, "aucune"] }
            ] },
            "hors_cible", "valide" ] } },
        { "key": "sexe", "type": "select_one", "label": { "fr": "Sexe du répondant", "en": "Respondent's sex" }, "required": true, "choices": "sexe", "appearance": "buttons" },
        { "key": "age_approx", "type": "integer", "label": { "fr": "Âge approximatif (ans)", "en": "Approximate age (years)" }, "min": 15, "max": 90 }
      ]
    },
    {
      "key": "C",
      "label": { "fr": "C. Profil du ménage" },
      "description": { "fr": "Fermé — 2 minutes." },
      "items": [
        { "key": "nb_enfants_scolarises", "type": "integer", "label": { "fr": "P1. Nombre d'enfants scolarisés de 3 à 18 ans" }, "required": true, "min": 1, "max": 15 },
        { "type": "group", "key": "p1_composition", "label": { "fr": "P1. Composition utile" }, "appearance": "matrix",
          "items": [
            { "key": "p1_ecole_privee", "type": "select_one", "label": { "fr": "École privée" }, "required": true, "choices": "oui_non" },
            { "key": "p1_aide_nounou", "type": "select_one", "label": { "fr": "Aide / nounou" }, "required": true, "choices": "oui_non" },
            { "key": "p1_chauffeur", "type": "select_one", "label": { "fr": "Chauffeur" }, "required": true, "choices": "oui_non" }
          ] },
        { "key": "p1_vehicule", "type": "select_one", "label": { "fr": "Véhicule du foyer" }, "required": true, "choices": "vehicule_foyer", "appearance": "buttons" },
        { "key": "p2_smartphone", "type": "select_one", "label": { "fr": "P2. Smartphone du répondant" }, "required": true, "choices": "smartphones", "appearance": "buttons" },
        { "key": "p3_consigne", "type": "note", "audience": "both", "style": "info",
          "label": { "fr": "P3. Quel moyen de transport les enfants utilisent-ils principalement pour se rendre sur leur lieu d'étude ? (Ne considérez que les enfants de 3 à 18 ans)" } },
        { "key": "p3_1_transport_aller", "type": "select_one", "label": { "fr": "P3.1 À l'aller" }, "required": true, "choices": "transports",
          "other": { "choice": "autre", "label": { "fr": "Précisez" } } },
        { "key": "p3_2_transport_retour", "type": "select_one", "label": { "fr": "P3.2 Au retour" }, "required": true, "choices": "transports",
          "other": { "choice": "autre", "label": { "fr": "Précisez" } } }
      ]
    },
    {
      "key": "D",
      "label": { "fr": "D. Situation actuelle — le problème tel qu'il le vit" },
      "description": { "fr": "3 minutes." },
      "items": [
        { "key": "d_consigne", "type": "note", "audience": "enumerator", "style": "warning",
          "label": { "fr": "Ne pas suggérer « GPS », « traceur », « kidnapping ». Laisser venir les mots. Si aucun incident : le noter explicitement, c'est un résultat." } },
        { "key": "d1_verification", "type": "select_one", "required": true, "choices": "d1_moyens",
          "label": { "fr": "D1. Quand vos enfants ne sont pas avec vous et que vous n'avez aucune idée du lieu où ils se trouvent (école, route, chez un proche), comment procédez-vous pour savoir où ils se trouvent concrètement ?" },
          "other": { "choice": "autre", "label": { "fr": "Autre : précisez" } } },
        { "key": "d1_precision", "type": "text", "appearance": "multiline", "label": { "fr": "D1. Précision (mots du parent)" },
          "hint": { "fr": "Mot pour mot. Pas de résumé." } },
        { "key": "d2_incident", "type": "select_one", "label": { "fr": "D2. Vous est-il déjà arrivé de ne pas savoir précisément où se trouvait l'un de vos enfants ?" }, "required": true, "choices": "oui_non", "appearance": "buttons",
          "hint": { "fr": "Oui → D3. Non → D4." } },
        { "key": "d3_recit", "type": "text", "appearance": "multiline", "required": true,
          "label": { "fr": "D3. Pourriez-vous relater la dernière occasion où vous ignoriez la localisation de l'un de vos enfants ? Que s'est-il produit par la suite ?" },
          "relevant": { "==": [{ "var": "d2_incident" }, "oui"] } },
        { "key": "d4_consigne", "type": "note", "audience": "enumerator", "style": "info",
          "label": { "fr": "D4 mesure si 4 000 FCFA/mois est de l'argent « invisible » ou un vrai arbitrage. Noter le silence s'il y en a un." } },
        { "key": "d4_verbatim", "type": "text", "appearance": "multiline",
          "label": { "fr": "D4. Si vous deviez ajouter 4 000 FCFA par mois à votre budget, est-ce que cela serait une augmentation importante ? (mots exacts, silence noté)" } },
        { "key": "d4_budget", "type": "select_one", "label": { "fr": "D4. Réponse" }, "required": true, "choices": "d4_reponses" }
      ]
    },
    {
      "key": "E",
      "label": { "fr": "E. Présentation du concept — à lire tel quel" },
      "items": [
        { "key": "e_consigne", "type": "note", "audience": "enumerator", "style": "warning",
          "label": { "fr": "Montrer l'appareil. Ne pas ajouter d'arguments (« c'est pour le kidnappeur », « ça marche même sans réseau », etc.). Après la lecture : silence. On attend la première réaction." } },
        { "key": "e_script", "type": "note", "audience": "respondent", "style": "script",
          "label": { "fr": "« Il s'agit d'un petit appareil que l'enfant met dans son sac à dos. Il permet de voir où se trouve l'enfant depuis votre téléphone, et de recevoir une alerte s'il sort d'une zone que vous avez définie. Vous pouvez aussi appeler l'appareil. L'appareil coûte environ 20 000 FCFA à l'achat, puis il y a un abonnement mensuel pour le service. »" } },
        { "key": "q5_reaction", "type": "text", "appearance": "multiline", "required": true,
          "label": { "fr": "5. Qu'est-ce que vous en pensez ? (Première réaction, mot pour mot)" },
          "postcode": { "choices": "q5_cotes", "multiple": false, "label": { "fr": "Cote enquêteur après coup, sans influencer" } } },
        { "key": "q6_consigne", "type": "note", "audience": "enumerator", "style": "info",
          "label": { "fr": "Laisser un silence. Ne pas répondre à l'objection. Relancer une seule fois : « Autre chose ? »" } },
        { "key": "q6_freins", "type": "text", "appearance": "multiline", "required": true,
          "label": { "fr": "6. Qu'est-ce qui vous empêcherait d'utiliser cette solution ?" },
          "postcode": { "choices": "q6_themes", "multiple": true, "label": { "fr": "Cocher ensuite les thèmes (plusieurs possibles), sans le dire à voix haute" } } },
        { "key": "q7_portera", "type": "select_one", "required": true, "choices": "q7_reponses", "appearance": "buttons",
          "label": { "fr": "7. Pensez-vous que cet enfant porterait le traqueur GPS quotidiennement ?" } },
        { "key": "q7_circonstances", "type": "text", "appearance": "multiline",
          "label": { "fr": "7. Dans quelles circonstances pourrait-il ne pas le porter ?" } },
        { "key": "q7b_emplacement", "type": "select_one", "required": true, "choices": "q7b_emplacements",
          "label": { "fr": "7b. Concrètement, où choisiriez-vous de le placer ?" } }
      ]
    },
    {
      "key": "F",
      "label": { "fr": "F. Prix — appareil et abonnement" },
      "description": { "fr": "3 minutes." },
      "items": [
        { "key": "f_consigne", "type": "note", "audience": "enumerator", "style": "info",
          "label": { "fr": "On cherche le point où ça casse, pas un « prix juste » théorique. Si la personne négocie, noter la négociation, ne pas accorder de rabais." } },
        { "key": "f1_prix_appareil", "type": "select_one", "required": true, "choices": "f1_reactions",
          "label": { "fr": "F1. À 20 000 FCFA pour l'appareil seulement, vous diriez :" } },
        { "key": "f2_prix_reponse", "type": "select_one", "required": true, "choices": "f2_reponses", "appearance": "buttons",
          "label": { "fr": "F2. À partir de quel prix d'appareil diriez-vous clairement : « Non, ça ne vaut pas le coup » ?" } },
        { "key": "f2_prix_rupture", "type": "currency", "currency": "XAF", "decimals": 0, "min": 0, "required": true,
          "label": { "fr": "F2. Montant (FCFA)" },
          "relevant": { "==": [{ "var": "f2_prix_reponse" }, "montant"] },
          "constraint": { ">=": [{ "var": "f2_prix_rupture" }, 1000] },
          "constraint_message": { "fr": "Indiquer un prix d'appareil d'au moins 1 000 FCFA." } },
        { "key": "f3_abonnement_refus", "type": "select_one", "required": true, "choices": "f3_abonnements",
          "label": { "fr": "F3. Pour un seul abonnement, à partir de quel montant mensuel décideriez-vous de refuser, même si vous trouvez la solution intéressante ?" },
          "other": { "choice": "autre", "label": { "fr": "Autre : montant en FCFA/mois" } } },
        { "key": "q10_option", "type": "select_one", "required": true, "choices": "q10_options",
          "label": { "fr": "10. Deux options. Laquelle choisiriez-vous — si vous deviez en choisir une ?" },
          "other": { "choice": "autre", "label": { "fr": "Autre option : précisez" } } }
      ]
    },
    {
      "key": "G",
      "label": { "fr": "G. Paiement récurrent — mécanique réelle" },
      "items": [
        { "key": "q10_moyen_paiement", "type": "select_one", "required": true, "choices": "moyens_paiement",
          "label": { "fr": "10. Quel moyen de règlement vous conviendrait le mieux ?" },
          "other": { "choice": "autre", "label": { "fr": "À préciser" } } },
        { "key": "q11_frequence", "type": "select_one", "required": true, "choices": "frequences_paiement",
          "label": { "fr": "11. Si vous aviez le choix, vous préféreriez :" },
          "other": { "choice": "autre", "label": { "fr": "À préciser" } } },
        { "key": "q11b_canal_rappel", "type": "select_one", "required": true, "choices": "canaux_rappel",
          "label": { "fr": "11b. Par quel canal de communication préféreriez-vous recevoir un rappel de paiement ?" },
          "other": { "choice": "autre", "label": { "fr": "À préciser" } } }
      ]
    },
    {
      "key": "H",
      "label": { "fr": "H. Confiance et marque" },
      "description": { "fr": "2 minutes." },
      "items": [
        { "key": "q12_position_permanente", "type": "select_one", "required": true, "choices": "q12_reponses",
          "label": { "fr": "12. Est-ce que ça vous dérange qu'une société connaisse la position de votre enfant en permanence ?" } },
        { "key": "q12_conditions", "type": "text", "appearance": "multiline",
          "label": { "fr": "12. Qu'est-ce qu'il faudrait pour que vous soyez à l'aise ? (mots exacts)" } },
        { "key": "q12b_societe_camerounaise", "type": "select_one", "required": true, "choices": "q12b_reponses",
          "label": { "fr": "12b. Cette société est camerounaise, encore peu connue. Ça change quelque chose ?" } },
        { "key": "q12c_solution_connue", "type": "select_one", "required": true, "choices": "q12c_reponses",
          "label": { "fr": "12c. Connaissez-vous déjà un objet ou une appli qui fait à peu près ça ?" },
          "other": { "choice": "autre", "label": { "fr": "Précisez" } } }
      ]
    },
    {
      "key": "T",
      "label": { "fr": "Test d'engagement — la seule question qui compte vraiment", "en": "Commitment test — the only question that really matters" },
      "description": { "fr": "Une seule proposition. Pas d'alternative (« on peut livrer », « vous payez demain », « je reviens samedi »). Puis silence.", "en": "One single offer. No alternative (\"we can deliver\", \"pay tomorrow\", \"I'll come back Saturday\"). Then silence." },
      "items": [
        { "key": "t_consigne", "type": "note", "audience": "enumerator", "style": "warning",
          "label": { "fr": "Proposer l'acompte une seule fois, puis silence. Accepter le non. Ne pas livrer l'appareil, ne pas proposer de « passer le prendre plus tard chez vous », ne pas relancer au téléphone.", "en": "Offer the deposit once, then silence. Accept the no. Do not deliver the device, do not offer to \"drop by later at your place\", do not follow up by phone." } },
        { "key": "point_retrait", "type": "text", "required": true, "max_length": 120,
          "label": { "fr": "Point de retrait annoncé aujourd'hui", "en": "Pick-up point announced today" } },
        { "key": "t_script", "type": "note", "audience": "respondent", "style": "script",
          "label": { "fr": "« Nous allons mettre les premiers appareils à disposition. Si vous voulez en réserver un, vous versez 5 000 FCFA maintenant par Mobile Money. C'est remboursable à tout moment, et ça se déduit du prix de l'appareil. Vous viendrez le récupérer à ${point_retrait} dans les 7 jours. Est-ce que vous voulez réserver ? »", "en": "\"We are about to make the first devices available. If you want to reserve one, you pay 5,000 FCFA now by Mobile Money. It is refundable at any time and is deducted from the price of the device. You will collect it at ${point_retrait} within 7 days. Do you want to reserve?\"" } },
        { "key": "temps_trajet_min", "type": "integer", "min": 0, "max": 300,
          "label": { "fr": "Quartier du point / temps de trajet estimé par la personne (minutes)", "en": "Travel time to the pick-up point as estimated by the person (minutes)" } },
        { "key": "q13_decision", "type": "select_one", "required": true, "choices": "decisions",
          "label": { "fr": "13. Décision", "en": "13. Decision" } },
        { "key": "acompte_verse", "type": "calculate", "label": { "fr": "Acompte versé (calculé)", "en": "Deposit paid (computed)" },
          "expression": { "in": [{ "var": "q13_decision" }, ["oui_paiement", "hesite_puis_oui"]] } },
        { "key": "q13_pretexte", "type": "text", "appearance": "multiline",
          "label": { "fr": "13. Prétexte du oui verbal (mots exacts)", "en": "13. Excuse given for the verbal yes (exact words)" },
          "relevant": { "==": [{ "var": "q13_decision" }, "oui_verbal"] } },
        { "key": "montant_recu", "type": "currency", "currency": "XAF", "decimals": 0, "min": 0, "required": true,
          "label": { "fr": "Montant reçu (FCFA)", "en": "Amount received (FCFA)" },
          "relevant": { "==": [{ "var": "acompte_verse" }, true] },
          "constraint": { "and": [{ ">=": [{ "var": "montant_recu" }, 1000] }, { "<=": [{ "var": "montant_recu" }, 20000] }] },
          "constraint_message": { "fr": "L'acompte est de 5 000 FCFA (minimum 1 000, maximum 20 000).", "en": "The deposit is 5,000 FCFA (minimum 1,000, maximum 20,000)." } },
        { "key": "operateur_momo", "type": "select_one", "required": true, "choices": "operateurs", "appearance": "buttons",
          "label": { "fr": "Opérateur", "en": "Operator" },
          "relevant": { "==": [{ "var": "acompte_verse" }, true] } },
        { "key": "reference_momo", "type": "text", "required": true, "max_length": 60,
          "label": { "fr": "Réf. / heure de la transaction", "en": "Transaction ref. / time" },
          "relevant": { "==": [{ "var": "acompte_verse" }, true] } },
        { "key": "num_whatsapp", "type": "text", "format": "phone", "required": true, "tags": ["pii"],
          "label": { "fr": "N° WhatsApp (si acompte)", "en": "WhatsApp number (if deposit)" },
          "relevant": { "==": [{ "var": "acompte_verse" }, true] },
          "constraint": { "regex": [{ "var": "num_whatsapp" }, "^6[0-9]{8}$"] },
          "constraint_message": { "fr": "Numéro camerounais à 9 chiffres commençant par 6.", "en": "9-digit Cameroonian number starting with 6." } },
        { "key": "nom_compte_momo", "type": "text", "required": true, "tags": ["pii"], "max_length": 80,
          "label": { "fr": "Nom sur le compte MoMo", "en": "Name on the MoMo account" },
          "relevant": { "==": [{ "var": "acompte_verse" }, true] } },
        { "key": "date_limite_retrait", "type": "date", "required": true,
          "label": { "fr": "Date limite de retrait (J+7)", "en": "Pick-up deadline (D+7)" },
          "hint": { "fr": "Remettre un petit papier : lieu, horaires, date limite, n° WhatsApp du point.", "en": "Hand over a small note: place, opening hours, deadline, WhatsApp number of the pick-up point." },
          "relevant": { "==": [{ "var": "acompte_verse" }, true] },
          "constraint": { "and": [
            { ">=": [{ "date_diff": [{ "var": "date_limite_retrait" }, { "today": [] }, "days"] }, 0] },
            { "<=": [{ "date_diff": [{ "var": "date_limite_retrait" }, { "today": [] }, "days"] }, 10] } ] },
          "constraint_message": { "fr": "La date limite doit être entre aujourd'hui et J+10.", "en": "The deadline must be between today and D+10." } },
        { "key": "photo_recu_momo", "type": "photo", "source": "camera",
          "label": { "fr": "Photo du reçu MoMo + code fiche", "en": "Photo of the MoMo receipt + form code" },
          "relevant": { "==": [{ "var": "acompte_verse" }, true] } },
        { "key": "q14_consigne", "type": "note", "audience": "enumerator", "style": "info",
          "label": { "fr": "14. Mots exacts. Relance unique autorisée : « C'est surtout ça, ou il y a autre chose ? »", "en": "14. Exact words. One follow-up allowed: \"Is it mainly that, or is there something else?\"" },
          "relevant": { "!=": [{ "var": "acompte_verse" }, true] } },
        { "key": "q14_motif", "type": "text", "appearance": "multiline", "required": true,
          "label": { "fr": "14. Si NON — pourquoi ?", "en": "14. If NO — why?" },
          "relevant": { "!=": [{ "var": "acompte_verse" }, true] } },
        { "key": "q14_motif_principal", "type": "select_one", "required": true, "choices": "themes_refus",
          "label": { "fr": "14. Thème principal du refus (cocher un seul)", "en": "14. Main reason for refusal (tick one only)" },
          "relevant": { "!=": [{ "var": "acompte_verse" }, true] } },
        { "key": "souhait_sans_acompte", "type": "select_one", "choices": "oui_non", "appearance": "buttons",
          "label": { "fr": "La personne veut l'appareil sans acompte ?", "en": "Does the person want the device without a deposit?" },
          "hint": { "fr": "Noter le souhait, ne pas céder — cela viderait le test.", "en": "Note the wish, do not give in — it would void the test." },
          "relevant": { "!=": [{ "var": "acompte_verse" }, true] } },
        { "key": "q15_consigne", "type": "note", "audience": "enumerator", "style": "info",
          "label": { "fr": "15. Observation enquêteur — ne pas lire.", "en": "15. Enumerator observation — do not read aloud." } },
