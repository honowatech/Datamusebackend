{
  "dfs_version": "1.0",
  "id": "7f2c1b0e-4c7a-4e2b-9a0e-3d5b6c7a8e01",
  "version": 1,
  "title": { "fr": "Étude de marché MunaGo — terrain", "en": "MunaGo market study — field" },
  "description": {
    "fr": "Questionnaire terrain MunaGo (traceur GPS enfant). Familles urbaines, Douala / Yaoundé, entretien face à face 12–15 min + test d'acompte. Une fiche = une personne. Transcription intégrale du document enquêteur « MunaGo — Questionnaire Terrain V1.0 » (septembre 2026).",
    "en": "MunaGo field questionnaire (child GPS tracker). Urban families, Douala / Yaoundé, 12–15 min face-to-face interview + deposit test. One form = one person."
  },
  "settings": {
    "languages": ["fr", "en"],
    "default_language": "fr",
    "fiche_code": {
      "pattern": "{VILLE}-{QUARTIER}-{NN}",
      "sources": { "VILLE": "ville", "QUARTIER": "quartier" },
      "counter": { "width": 2, "scope": "enumerator", "start": 1 }
    },
    "quotas": [
      { "key": "total_valid", "label": { "fr": "Fiches valides (objectif 30)", "en": "Valid forms (target 30)" }, "target": 30, "scope": "survey",
        "filter": { "==": [{ "var": "_status" }, "completed"] } },
      { "key": "quartiers_distincts", "label": { "fr": "Quartiers distincts (au moins 3)", "en": "Distinct neighbourhoods (at least 3)" }, "target": 3, "scope": "distinct", "question": "quartier" },
      { "key": "par_reseau", "label": { "fr": "Maximum 5 fiches par réseau d'origine", "en": "At most 5 forms per origin network" }, "target": 5, "scope": "answer", "question": "reseau_origine", "max": true,
        "filter": { "!=": [{ "var": "reseau_origine" }, "direct"] } },
      { "key": "par_quartier", "label": { "fr": "Fiches par zone d'affectation (objectif 10)", "en": "Forms per assigned zone (target 10)" }, "target": 10, "scope": "zone" }
    ],
    "kpis": [
      { "key": "taux_acompte", "label": { "fr": "% d'acompte / fiches valides", "en": "% deposit / valid forms" },
        "numerator": { "in": [{ "var": "q13_decision" }, ["oui_paiement", "hesite_puis_oui"]] }, "denominator": "valid", "format": "percent" },
      { "key": "taux_retrait", "label": { "fr": "% retrait ≤ 7 j parmi les acomptes", "en": "% pick-up within 7 days among deposits" },
        "numerator": { "==": [{ "var": "j7_retire" }, "oui"] },
        "denominator": { "in": [{ "var": "q13_decision" }, ["oui_paiement", "hesite_puis_oui"]] }, "format": "percent" },
      { "key": "taux_activation_j14", "label": { "fr": "% activé à J+14 parmi les appareils retirés", "en": "% activated at D+14 among picked-up devices" },
        "numerator": { "==": [{ "var": "j14_active" }, "oui"] },
        "denominator": { "==": [{ "var": "j7_retire" }, "oui"] }, "format": "percent" },
      { "key": "taux_hors_cible", "label": { "fr": "% hors cible / contacts", "en": "% screened out / contacts" },
        "numerator": { "==": [{ "var": "_status" }, "screened_out"] }, "denominator": "all", "format": "percent" }
    ],
    "geo": { "capture": "both", "required": false, "accuracy_max_m": 50 },
    "timing": { "min_duration_seconds": 600, "max_duration_seconds": 1080 },
    "duplicate_keys": ["num_whatsapp"],
    "pagination": "section",
    "allow_public_link": true,
    "enumerator_can_edit_after_submit": false,
    "followup_contact_keys": ["num_whatsapp", "nom_compte_momo"]
  },
